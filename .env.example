# Local development: copy to .env.local and adjust.
# Start a local DB with:
#   docker network create cocarry
#   POSTGRES_USER=cocarry POSTGRES_PASSWORD=devpassword docker compose -f docker-compose.db.yml up -d
#   docker exec -i cocarry-postgres psql -U cocarry -d cocarry < db/schema.sql
PGHOST=127.0.0.1
PGPORT=5433
PGUSER=cocarry
PGPASSWORD=devpassword
PGDATABASE=cocarry
